  "patch_receipt": {
    "upstream_commit": "bfba07c77a5fcba1cc772d42f2d9e9be8a542df8",
    "original_sha256": "50b95793159e7966c5deda3f41961ea41a8268fd185c4d3dd9c1280365613bb6",
    "patched_sha256": "1a5c09a861085bf6325588351d56c5038e6a2e86752990c66884938cae1839a5",
    "patch": "--- a/linx/abundances.py\n+++ b/linx/abundances.py\n@@ -128,7 +128,7 @@\n         Y_i=None, T_start=None, T_end=None, sampling_nTOp=150, \n         rtol=1e-6, atol=1e-9, solver=Kvaerno3(),\n         max_steps=4096,\n-        save_history=False\n+        save_history=False, rate_tables_override=None\n     ):\n         \"\"\"\n         Calculate BBN abundance. \n@@ -154,6 +154,10 @@\n         tau_n_fac : float, optional\n             Rescaling factor for neutron decay lifetime, 1 for fiducial value \n             in `const.tau_n`. \n+        rate_tables_override : tuple of arrays, optional\n+            Prevalidated full rate-table tuple in reaction order. Uses\n+            existing Reaction nodes and encoding. Replaces table building\n+            only; nuclear_rates_q is not applied again. See host adapter.\n         nuclear_rates_q : array, optional\n             q ~ N(0,1) specifies the nuclear rate in its log-normal \n             distribution. If not specified, will be taken to be `q = 0`. \n@@ -313,7 +317,11 @@\n             saveat = SaveAt(t1=True)\n \n         # Precompute rate tables once, outside the ODE RHS.\n-        rate_tables = self.nuclear_net.precompute_rate_tables(nuclear_rates_q)\n+        # Low-level override: host validation belongs to the caller.\n+        rate_tables = (\n+            self.nuclear_net.precompute_rate_tables(nuclear_rates_q)\n+            if rate_tables_override is None else rate_tables_override\n+        )\n         sol = diffeqsolve(\n             ODETerm(self.Y_prime), solver,\n             t0=t_start, t1=t_end, dt0=None, y0=Y_i,\n"
  },
  "wall_seconds": 45.40085309699998,
